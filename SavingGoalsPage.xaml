<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinalApp.SavingGoalsPage"
             Title="Saving Goals"
             BackgroundColor="White">

    <StackLayout Padding="20" Spacing="20">

        <!-- Header -->
        <Label Text="🎯 Saving Goals"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="DarkGreen"
               HorizontalOptions="Center" />

        <!-- Goals List -->
        <CollectionView x:Name="GoalsList"
                        ItemsSource="{Binding SavingGoals}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="15"
                           CornerRadius="15"
                           Margin="0,5"
                           BackgroundColor="#F0F0F0"
                           HasShadow="True">
                        <StackLayout>
                            <Label Text="{Binding Name}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="Black" />

                            <ProgressBar Progress="{Binding Progress}"
                                         HeightRequest="10"
                                         ProgressColor="DarkGreen"
                                         BackgroundColor="#D0E6D0"
                                         Margin="0,5"/>

                            <Label Text="{Binding DisplayAmount}"
                                   FontSize="14"
                                   TextColor="#4F4F4F" />
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Add Goal Button -->
        <Button Text="➕ Add New Goal"
                BackgroundColor="DarkGreen"
                TextColor="White"
                CornerRadius="12"
                FontSize="18"
                HeightRequest="50"
                Clicked="OnAddGoalClicked"/>
    </StackLayout>
</ContentPage>
