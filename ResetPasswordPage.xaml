<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinalApp.ResetPasswordPage"
             Title="Reset Password"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="CenterAndExpand">

            <!-- Page Title -->
            <Label Text="RESET PASSWORD"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="DarkGreen" />

            <!-- Email -->
            <Frame CornerRadius="10" HasShadow="False" BorderColor="Gray" BackgroundColor="#F0F0F0" Padding="10">
                <Entry x:Name="EmailEntry" Placeholder="Registered Email" Keyboard="Email" TextColor="Black" />
            </Frame>

            <!-- New Password -->
            <Frame CornerRadius="10" HasShadow="False" BorderColor="Gray" BackgroundColor="#F0F0F0" Padding="10">
                <Entry x:Name="NewPasswordEntry" Placeholder="New Password" IsPassword="True" TextColor="Black" />
            </Frame>

            <!-- Confirm Password -->
            <Frame CornerRadius="10" HasShadow="False" BorderColor="Gray" BackgroundColor="#F0F0F0" Padding="10">
                <Entry x:Name="ConfirmPasswordEntry" Placeholder="New Password" IsPassword="True" TextColor="Black" />
            </Frame>

            <!-- Reset Button -->
            <Button Text="Reset Password"
                    Clicked="OnResetPasswordClicked"
                    BackgroundColor="DarkGreen"
                    TextColor="White"
                    HeightRequest="50"
                    CornerRadius="10"
                    FontAttributes="Bold"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
